%template(DoubleArray6x2) std::array<std::array<double, 2>, 6>;
%template(DoubleArray63) std::array<std::array<double, 3>, 6>;
%template(DoubleArray6x4) std::array<std::array<double, 4>, 6>;
%template(DoubleArray6x5) std::array<std::array<double, 5>, 6>;
