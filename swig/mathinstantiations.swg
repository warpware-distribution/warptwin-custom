/* ---- the std::array shapes the list constructors convert through ----
 *
 * Matrix and CartesianVector both take a std::array in their constructors, and std_array.i turns
 * a Python list into one. Every shape needs its array instantiated or list construction for that
 * shape fails at the typemap. These have to precede the matrix templates that use them. */
%template(DoubleArray1) std::array<double, 1>;
%template(DoubleArray2) std::array<double, 2>;
%template(DoubleArray3) std::array<double, 3>;
%template(DoubleArray4) std::array<double, 4>;
%template(DoubleArray5) std::array<double, 5>;
%template(DoubleArray6) std::array<double, 6>;
%template(DoubleArray16) std::array<double, 16>;

%template(DoubleArray1x1) std::array<std::array<double, 1>, 1>;
%template(DoubleArray1x2) std::array<std::array<double, 2>, 1>;
%template(DoubleArray1x3) std::array<std::array<double, 3>, 1>;
%template(DoubleArray1x4) std::array<std::array<double, 4>, 1>;
%template(DoubleArray1x5) std::array<std::array<double, 5>, 1>;
%template(DoubleArray1x6) std::array<std::array<double, 6>, 1>;
%template(DoubleArray2x1) std::array<std::array<double, 1>, 2>;
%template(DoubleArray22) std::array<std::array<double, 2>, 2>;
%template(DoubleArray2x3) std::array<std::array<double, 3>, 2>;
%template(DoubleArray2x4) std::array<std::array<double, 4>, 2>;
%template(DoubleArray2x5) std::array<std::array<double, 5>, 2>;
%template(DoubleArray2x6) std::array<std::array<double, 6>, 2>;
%template(DoubleArray3x1) std::array<std::array<double, 1>, 3>;
%template(DoubleArray3x2) std::array<std::array<double, 2>, 3>;
%template(DoubleArray33) std::array<std::array<double, 3>, 3>;
%template(DoubleArray3x4) std::array<std::array<double, 4>, 3>;
%template(DoubleArray3x5) std::array<std::array<double, 5>, 3>;
%template(DoubleArray3x6) std::array<std::array<double, 6>, 3>;
%template(DoubleArray4x1) std::array<std::array<double, 1>, 4>;
%template(DoubleArray4x2) std::array<std::array<double, 2>, 4>;
%template(DoubleArray4x3) std::array<std::array<double, 3>, 4>;
%template(DoubleArray44) std::array<std::array<double, 4>, 4>;
%template(DoubleArray4x5) std::array<std::array<double, 5>, 4>;
%template(DoubleArray4x6) std::array<std::array<double, 6>, 4>;
%template(DoubleArray5x1) std::array<std::array<double, 1>, 5>;
%template(DoubleArray5x2) std::array<std::array<double, 2>, 5>;
%template(DoubleArray5x3) std::array<std::array<double, 3>, 5>;
%template(DoubleArray5x4) std::array<std::array<double, 4>, 5>;
