/* One predictable naming rule for every shape, alongside the names already in use. The legacy
 * spellings stay because scripts import them; Matrix16 in particular has always meant the 16x16
 * covariance type rather than a 1x6, so the RxC form is the unambiguous one to reach for.
 *
 * Assigned through globals() and guarded on the target existing, because every per-model module
 * generated from swigtemplate.txt %includes WarpTwinPy.i and therefore this file. Those modules
 * %ignore the matrix classes -- they use the ones WarpTwinPy already publishes -- so the names
 * are absent there, and a plain assignment raised NameError on import of every model. */
%pythoncode %{
_wt_matrix_aliases = {
    "Matrix2x1": "Matrix21",
    "Matrix2x2": "Matrix2",
    "Matrix3x1": "Matrix31",
    "Matrix3x3": "Matrix3",
    "Matrix4x1": "Matrix41",
    "Matrix4x4": "Matrix4",
    "Matrix6x1": "Matrix61",
    "Matrix6x3": "Matrix63",
    "Matrix6x6": "Matrix6",
    "Matrix16x16": "Matrix16",
    "Matrix10x10": "Matrix10",
}
for _wt_alias, _wt_target in _wt_matrix_aliases.items():
    if _wt_target in globals():
        globals()[_wt_alias] = globals()[_wt_target]
del _wt_matrix_aliases, _wt_alias, _wt_target
%}
