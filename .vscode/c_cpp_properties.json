{
    "configurations": [
        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/src",
                "${workspaceFolder}/includes/warptwin_sim",
                "${workspaceFolder}/includes/thirdparty",
                "/usr/include/warptwin",
                "/usr/include/hdf5/serial"
            ],
            "defines": [
                "MODELSPACE_ROOT_DIR=\"/usr/share/warptwin\"",
                "CLOCKWERK_ROOT_DIR=\"/usr/share/warptwin\"",
                "PROJECT_ROOT_DIR=\"/usr/share/warptwin\"",
                "LICENSE_ROOT_DIR=\"/etc/warptwin\""
            ],
            "cStandard": "c99",
            "cppStandard": "c++17",
            "compilerPath": "/usr/bin/g++",
            "compileCommands": "${workspaceFolder}/build/compile_commands.json"
        },
        {
            "name": "Mac",
            "includePath": [
                "${workspaceFolder}/src",
                "${workspaceFolder}/includes/warptwin_sim",
                "${workspaceFolder}/includes/thirdparty",
                "/usr/local/warptwin/include/warptwin",
                "/opt/homebrew/include",
                "/usr/local/include"
            ],
            "defines": [
                "MODELSPACE_ROOT_DIR=\"/usr/local/warptwin/share/warptwin\"",
                "CLOCKWERK_ROOT_DIR=\"/usr/local/warptwin/share/warptwin\"",
                "PROJECT_ROOT_DIR=\"/usr/local/warptwin/share/warptwin\"",
                "LICENSE_ROOT_DIR=\"/usr/local/warptwin/share/warptwin\""
            ],
            "cStandard": "c99",
            "cppStandard": "c++17",
            "compilerPath": "/usr/bin/clang++",
            "compileCommands": "${workspaceFolder}/build/compile_commands.json"
        }
    ],
    "version": 4
}
